<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Android: one <test> block per device. "port" is the UiAutomator2 system port - give every
     device in a parallel run its own. -->
<suite name="android-local" parallel="tests" thread-count="4">
    <parameter name="config" value="config/config.properties"/>

    <test name="android-device-1">
        <parameter name="udid" value="emulator-5554"/>
        <parameter name="port" value="8210"/>
        <parameter name="deviceName" value="Android Emulator"/>
        <classes>
            <class name="tests.android.search.SearchTests">
                <methods>
                    <include name="searchOpensArticle"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
